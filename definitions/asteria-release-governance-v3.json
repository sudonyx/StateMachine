{
    "languageVersion":  "1.3",
    "id":  "asteria-release-governance",
    "version":  "3.0",
    "initialState":  "Draft",
    "states":  [
                   {
                       "id":  "Draft"
                   },
                   {
                       "id":  "UnderAssessment"
                   },
                   {
                       "id":  "RequirementsIdentified"
                   },
                   {
                       "id":  "ReviewObligationsIdentified"
                   },
                   {
                       "id":  "AssessmentUnresolved"
                   },
                   {
                       "id":  "Prohibited",
                       "terminal":  true
                   },
                   {
                       "id":  "Cancelled",
                       "terminal":  true
                   },
                   {
                       "id":  "Superseded",
                       "terminal":  true
                   }
               ],
    "events":  [
                   "Submit",
                   "Cancel",
                   "AsteriaAssessmentObserved",
                   "SupersedeAssessment"
               ],
    "inputPolicy":  {
                        "commands":  [
                                         {
                                             "name":  "CancelRelease",
                                             "event":  "Cancel"
                                         },
                                         {
                                             "name":  "RequestFunctionalVerification",
                                             "event":  "RequestFunctionalVerification",
                                             "concern":  "FunctionalVerification"
                                         },
                                         {
                                             "name":  "RequestSecurityVerification",
                                             "event":  "RequestSecurityVerification",
                                             "concern":  "SecurityVerification"
                                         },
                                         {
                                             "name":  "RequestReleaseReview",
                                             "event":  "RequestApproval",
                                             "concern":  "ReleaseReviewApproval"
                                         },
                                         {
                                             "name":  "RequestEmergencyApproval",
                                             "event":  "RequestApproval",
                                             "concern":  "EmergencyApproval"
                                         },
                                         {
                                             "name":  "RequestCancellation",
                                             "event":  "RequestCancellation",
                                             "concern":  "CancellationIntent"
                                         }
                                     ],
                        "observations":  [
                                             {
                                                 "name":  "AsteriaAssessmentStarted",
                                                 "event":  "Submit",
                                                 "requiredEvidence":  [
                                                                          "releaseId",
                                                                          "assessmentGeneration",
                                                                          "materialDigest"
                                                                      ]
                                             },
                                             {
                                                 "name":  "AsteriaAssessmentObserved",
                                                 "event":  "AsteriaAssessmentObserved",
                                                 "requiredEvidence":  [
                                                                          "releaseId",
                                                                          "assessmentGeneration",
                                                                          "materialDigest",
                                                                          "parentRevision",
                                                                          "expectedOperationId",
                                                                          "decisionRequestFingerprint",
                                                                          "selectedPolicySourceVersions",
                                                                          "originalResponse",
                                                                          "policySelectionContext"
                                                                      ]
                                             },
                                             {
                                                 "name":  "SupersedeAssessment",
                                                 "event":  "SupersedeAssessment",
                                                 "requiredEvidence":  [
                                                                          "amendmentId",
                                                                          "requestFingerprint",
                                                                          "expectedBaseGeneration",
                                                                          "replacementGeneration",
                                                                          "replacementMaterialDigest"
                                                                      ]
                                             }
                                         ]
                    },
    "transitions":  [
                        {
                            "id":  "submit-complete-draft",
                            "source":  "Draft",
                            "event":  "Submit",
                            "target":  "UnderAssessment",
                            "description":  "Record a local submission request only when its expressible scalar, range, and vocabulary checks pass.",
                            "guard":  {
                                          "op":  "and",
                                          "args":  [
                                                       {
                                                           "op":  "ne",
                                                           "fact":  "releaseId",
                                                           "value":  ""
                                                       },
                                                       {
                                                           "op":  "gte",
                                                           "fact":  "assessmentGeneration",
                                                           "value":  1
                                                       },
                                                       {
                                                           "op":  "ne",
                                                           "fact":  "materialDigest",
                                                           "value":  ""
                                                       },
                                                       {
                                                           "op":  "ne",
                                                           "fact":  "product",
                                                           "value":  ""
                                                       },
                                                       {
                                                           "op":  "ne",
                                                           "fact":  "targetVersion",
                                                           "value":  ""
                                                       },
                                                       {
                                                           "op":  "or",
                                                           "args":  [
                                                                        {
                                                                            "op":  "eq",
                                                                            "fact":  "environment",
                                                                            "value":  "development"
                                                                        },
                                                                        {
                                                                            "op":  "eq",
                                                                            "fact":  "environment",
                                                                            "value":  "staging"
                                                                        },
                                                                        {
                                                                            "op":  "eq",
                                                                            "fact":  "environment",
                                                                            "value":  "production"
                                                                        },
                                                                        {
                                                                            "op":  "eq",
                                                                            "fact":  "environment",
                                                                            "value":  "unmanaged-production"
                                                                        }
                                                                    ]
                                                       },
                                                       {
                                                           "op":  "or",
                                                           "args":  [
                                                                        {
                                                                            "op":  "eq",
                                                                            "fact":  "releaseCategory",
                                                                            "value":  "Standard"
                                                                        },
                                                                        {
                                                                            "op":  "eq",
                                                                            "fact":  "releaseCategory",
                                                                            "value":  "Emergency"
                                                                        }
                                                                    ]
                                                       },
                                                       {
                                                           "op":  "or",
                                                           "args":  [
                                                                        {
                                                                            "op":  "eq",
                                                                            "fact":  "changeSize",
                                                                            "value":  "Small"
                                                                        },
                                                                        {
                                                                            "op":  "eq",
                                                                            "fact":  "changeSize",
                                                                            "value":  "Medium"
                                                                        },
                                                                        {
                                                                            "op":  "eq",
                                                                            "fact":  "changeSize",
                                                                            "value":  "Large"
                                                                        }
                                                                    ]
                                                       },
                                                       {
                                                           "op":  "or",
                                                           "args":  [
                                                                        {
                                                                            "op":  "eq",
                                                                            "fact":  "authenticationChange",
                                                                            "value":  true
                                                                        },
                                                                        {
                                                                            "op":  "eq",
                                                                            "fact":  "authenticationChange",
                                                                            "value":  false
                                                                        }
                                                                    ]
                                                       },
                                                       {
                                                           "op":  "or",
                                                           "args":  [
                                                                        {
                                                                            "op":  "eq",
                                                                            "fact":  "customerDataImpact",
                                                                            "value":  true
                                                                        },
                                                                        {
                                                                            "op":  "eq",
                                                                            "fact":  "customerDataImpact",
                                                                            "value":  false
                                                                        }
                                                                    ]
                                                       },
                                                       {
                                                           "op":  "ne",
                                                           "fact":  "releaseSummary",
                                                           "value":  ""
                                                       },
                                                       {
                                                           "op":  "ne",
                                                           "fact":  "plannedDeploymentAt",
                                                           "value":  ""
                                                       },
                                                       {
                                                           "op":  "ne",
                                                           "fact":  "releaseOwner",
                                                           "value":  ""
                                                       }
                                                   ]
                                      }
                        },
                        {
                            "id":  "cancel-draft",
                            "source":  "Draft",
                            "event":  "Cancel",
                            "target":  "Cancelled",
                            "description":  "Accept explicit pre-deployment cancellation only when deployment has not been prepared.",
                            "guard":  {
                                          "op":  "concernState",
                                          "concern":  "CancellationIntent",
                                          "state":  "Requested"
                                      }
                        },
                        {
                            "id":  "cancel-under-assessment",
                            "source":  "UnderAssessment",
                            "event":  "Cancel",
                            "target":  "Cancelled",
                            "description":  "Accept explicit pre-deployment cancellation only when deployment has not been prepared.",
                            "guard":  {
                                          "op":  "concernState",
                                          "concern":  "CancellationIntent",
                                          "state":  "Requested"
                                      }
                        },
                        {
                            "id":  "asteria-assessment-prohibited",
                            "source":  "UnderAssessment",
                            "event":  "AsteriaAssessmentObserved",
                            "target":  "Prohibited",
                            "description":  "Preserve a verified policy prohibition without providing an override or deployment path.",
                            "guard":  {
                                          "op":  "eq",
                                          "fact":  "assessmentOutcome",
                                          "value":  "Prohibited"
                                      }
                        },
                        {
                            "id":  "asteria-assessment-requirements-identified",
                            "source":  "UnderAssessment",
                            "event":  "AsteriaAssessmentObserved",
                            "target":  "RequirementsIdentified",
                            "description":  "Record that applicable obligations were identified; this does not mean any obligation was fulfilled.",
                            "guard":  {
                                          "op":  "eq",
                                          "fact":  "assessmentOutcome",
                                          "value":  "RequirementsDetermined"
                                      }
                        },
                        {
                            "id":  "asteria-assessment-review-obligations-identified",
                            "source":  "UnderAssessment",
                            "event":  "AsteriaAssessmentObserved",
                            "target":  "ReviewObligationsIdentified",
                            "description":  "Record that additional review obligations were identified; this does not mean approval was granted.",
                            "guard":  {
                                          "op":  "eq",
                                          "fact":  "assessmentOutcome",
                                          "value":  "AdditionalReviewRequired"
                                      }
                        },
                        {
                            "id":  "asteria-assessment-unresolved",
                            "source":  "UnderAssessment",
                            "event":  "AsteriaAssessmentObserved",
                            "target":  "AssessmentUnresolved",
                            "description":  "Preserve an unresolved assessment without permitting deployment-ready progression.",
                            "guard":  {
                                          "op":  "eq",
                                          "fact":  "assessmentOutcome",
                                          "value":  "Unresolved"
                                      }
                        },
                        {
                            "id":  "supersede-assessment-draft",
                            "source":  "Draft",
                            "event":  "SupersedeAssessment",
                            "target":  "Superseded",
                            "description":  "Record an evidenced supersession of this pre-deployment assessment."
                        },
                        {
                            "id":  "supersede-assessment-under-assessment",
                            "source":  "UnderAssessment",
                            "event":  "SupersedeAssessment",
                            "target":  "Superseded",
                            "description":  "Record an evidenced supersession of this pre-deployment assessment."
                        },
                        {
                            "id":  "supersede-assessment-requirements-identified",
                            "source":  "RequirementsIdentified",
                            "event":  "SupersedeAssessment",
                            "target":  "Superseded",
                            "description":  "Record an evidenced supersession of this pre-deployment assessment."
                        },
                        {
                            "id":  "supersede-assessment-review-obligations-identified",
                            "source":  "ReviewObligationsIdentified",
                            "event":  "SupersedeAssessment",
                            "target":  "Superseded",
                            "description":  "Record an evidenced supersession of this pre-deployment assessment."
                        },
                        {
                            "id":  "supersede-assessment-assessment-unresolved",
                            "source":  "AssessmentUnresolved",
                            "event":  "SupersedeAssessment",
                            "target":  "Superseded",
                            "description":  "Record an evidenced supersession of this pre-deployment assessment."
                        }
                    ],
    "concerns":  [
                     {
                         "id":  "FunctionalVerification",
                         "initialState":  "NotRequested",
                         "states":  [
                                        {
                                            "id":  "NotRequested"
                                        },
                                        {
                                            "id":  "Requested"
                                        },
                                        {
                                            "id":  "Passed",
                                            "terminal":  true
                                        },
                                        {
                                            "id":  "Failed",
                                            "terminal":  true
                                        },
                                        {
                                            "id":  "Indeterminate"
                                        },
                                        {
                                            "id":  "Superseded"
                                        }
                                    ],
                         "events":  [
                                        "RequestFunctionalVerification"
                                    ],
                         "transitions":  [
                                             {
                                                 "id":  "request-functional-verification",
                                                 "source":  "NotRequested",
                                                 "event":  "RequestFunctionalVerification",
                                                 "target":  "Requested"
                                             }
                                         ]
                     },
                     {
                         "id":  "SecurityVerification",
                         "initialState":  "NotRequested",
                         "states":  [
                                        {
                                            "id":  "NotRequested"
                                        },
                                        {
                                            "id":  "Requested"
                                        },
                                        {
                                            "id":  "Passed",
                                            "terminal":  true
                                        },
                                        {
                                            "id":  "Failed",
                                            "terminal":  true
                                        },
                                        {
                                            "id":  "Indeterminate"
                                        },
                                        {
                                            "id":  "Superseded"
                                        }
                                    ],
                         "events":  [
                                        "RequestSecurityVerification"
                                    ],
                         "transitions":  [
                                             {
                                                 "id":  "request-security-verification",
                                                 "source":  "NotRequested",
                                                 "event":  "RequestSecurityVerification",
                                                 "target":  "Requested"
                                             }
                                         ]
                     },
                     {
                         "id":  "ReleaseReviewApproval",
                         "initialState":  "NotRequested",
                         "states":  [
                                        {
                                            "id":  "NotRequested"
                                        },
                                        {
                                            "id":  "Requested"
                                        },
                                        {
                                            "id":  "Approved",
                                            "terminal":  true
                                        },
                                        {
                                            "id":  "Rejected",
                                            "terminal":  true
                                        },
                                        {
                                            "id":  "Unresolved"
                                        }
                                    ],
                         "events":  [
                                        "RequestApproval"
                                    ],
                         "transitions":  [
                                             {
                                                 "id":  "request-release-review",
                                                 "source":  "NotRequested",
                                                 "event":  "RequestApproval",
                                                 "target":  "Requested"
                                             }
                                         ]
                     },
                     {
                         "id":  "EmergencyApproval",
                         "initialState":  "NotRequested",
                         "states":  [
                                        {
                                            "id":  "NotRequested"
                                        },
                                        {
                                            "id":  "Requested"
                                        },
                                        {
                                            "id":  "Approved",
                                            "terminal":  true
                                        },
                                        {
                                            "id":  "Rejected",
                                            "terminal":  true
                                        },
                                        {
                                            "id":  "Unresolved"
                                        }
                                    ],
                         "events":  [
                                        "RequestApproval"
                                    ],
                         "transitions":  [
                                             {
                                                 "id":  "request-emergency-approval",
                                                 "source":  "NotRequested",
                                                 "event":  "RequestApproval",
                                                 "target":  "Requested"
                                             }
                                         ]
                     },
                     {
                         "id":  "CancellationIntent",
                         "initialState":  "NotRequested",
                         "states":  [
                                        {
                                            "id":  "NotRequested"
                                        },
                                        {
                                            "id":  "Requested",
                                            "terminal":  true
                                        }
                                    ],
                         "events":  [
                                        "RequestCancellation"
                                    ],
                         "transitions":  [
                                             {
                                                 "id":  "record-cancellation-intent",
                                                 "source":  "NotRequested",
                                                 "event":  "RequestCancellation",
                                                 "target":  "Requested"
                                             }
                                         ]
                     }
                 ]
}
