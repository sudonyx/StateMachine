{
  "openapi": "3.0.3",
  "info": {
    "title": "Asteria Synthetic Functional Verification",
    "version": "1.0.0",
    "description": "Deterministic local-only synthetic verification. Passed results are demonstration fixtures, not production quality evidence."
  },
  "servers": [
    { "url": "http://127.0.0.1:5274" }
  ],
  "paths": {
    "/verification": {
      "post": {
        "operationId": "verifyFunctionalRelease",
        "summary": "Evaluate the synthetic functional verification concern",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VerificationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bound verification result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VerificationResponse" }
              }
            }
          },
          "400": { "description": "Invalid request binding" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VerificationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["releaseId", "assessmentGeneration", "materialDigest", "workflowInstanceId", "concernId", "activityId", "expectedOperationId"],
        "properties": {
          "releaseId": { "type": "string" },
          "assessmentGeneration": { "type": "integer", "minimum": 1 },
          "materialDigest": { "type": "string" },
          "workflowInstanceId": { "type": "string" },
          "concernId": { "type": "string", "enum": ["FunctionalVerification"] },
          "activityId": { "type": "string" },
          "expectedOperationId": { "type": "string" }
        }
      },
      "VerificationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["releaseId", "assessmentGeneration", "materialDigest", "workflowInstanceId", "concernId", "activityId", "expectedOperationId", "result", "evidenceId"],
        "properties": {
          "releaseId": { "type": "string" },
          "assessmentGeneration": { "type": "integer" },
          "materialDigest": { "type": "string" },
          "workflowInstanceId": { "type": "string" },
          "concernId": { "type": "string" },
          "activityId": { "type": "string" },
          "expectedOperationId": { "type": "string" },
          "result": { "type": "string", "enum": ["Passed", "Failed", "Indeterminate"] },
          "evidenceId": { "type": "string" }
        }
      }
    }
  }
}
